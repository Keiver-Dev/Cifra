<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude private vault database and PIN preferences from cloud backups -->
        <exclude domain="database" path="cifra_vault.db" />
        <exclude domain="database" path="cifra_vault.db-shm" />
        <exclude domain="database" path="cifra_vault.db-wal" />
        <exclude domain="sharedpref" path="pin_store.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude private vault database and PIN preferences from device-to-device transfers -->
        <exclude domain="database" path="cifra_vault.db" />
        <exclude domain="database" path="cifra_vault.db-shm" />
        <exclude domain="database" path="cifra_vault.db-wal" />
        <exclude domain="sharedpref" path="pin_store.preferences_pb" />
    </device-transfer>
</data-extraction-rules>